// CitiCare - Database Schema
// PostgreSQL + Prisma ORM
// 13 Tables: Users, Departments, Complaints, Notifications, Audit Logs, etc.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CITIZEN
  OFFICIAL
  ADMIN
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  REOPENED
}

enum NotificationType {
  SUCCESS
  INFO
  WARNING
  ERROR
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String
  password  String
  role      Role     @default(CITIZEN)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  complaints       Complaint[]
  departmentUsers  DepartmentUser[]
  statusUpdates    ComplaintStatusHistory[] @relation("StatusUpdatedBy")
  feedbacks        ComplaintFeedback[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─── Departments ──────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Relations
  departmentUsers          DepartmentUser[]
  categoryDepartmentMappings CategoryDepartmentMapping[]
  complaints               Complaint[]

  @@index([code])
  @@map("departments")
}

// ─── Department Users (Officials ↔ Departments) ──────────────────────────────

model DepartmentUser {
  id           String     @id @default(uuid())
  userId       String
  departmentId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("department_users")
}

// ─── Complaint Categories ────────────────────────────────────────────────────

model ComplaintCategory {
  id       String @id @default(uuid())
  name     String @unique
  icon     String
  severity Int    @default(1)

  // Relations
  categoryDepartmentMappings CategoryDepartmentMapping[]
  complaints                 Complaint[]
  slaRules                   SlaRule[]

  @@map("complaint_categories")
}

// ─── Category → Department Mapping ───────────────────────────────────────────

model CategoryDepartmentMapping {
  id           String @id @default(uuid())
  categoryId   String
  departmentId String

  category   ComplaintCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  department Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([categoryId, departmentId])
  @@index([categoryId])
  @@index([departmentId])
  @@map("category_department_mapping")
}

// ─── Complaints ──────────────────────────────────────────────────────────────

model Complaint {
  id              String          @id @default(uuid())
  complaintNumber String          @unique
  citizenId       String
  categoryId      String
  departmentId    String?
  title           String
  description     String
  latitude        Decimal?
  longitude       Decimal?
  address         String?
  priorityScore   Decimal?        @default(0)
  status          ComplaintStatus @default(SUBMITTED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  citizen    User               @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  category   ComplaintCategory  @relation(fields: [categoryId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  images     ComplaintImage[]
  statusHistory ComplaintStatusHistory[]
  feedback   ComplaintFeedback?

  @@index([complaintNumber])
  @@index([citizenId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([latitude, longitude])
  @@map("complaints")
}

// ─── Complaint Images ────────────────────────────────────────────────────────

model ComplaintImage {
  id          String   @id @default(uuid())
  complaintId String
  imageUrl    String
  uploadedAt  DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_images")
}

// ─── Complaint Status History ────────────────────────────────────────────────

model ComplaintStatusHistory {
  id             String          @id @default(uuid())
  complaintId    String
  previousStatus ComplaintStatus
  currentStatus  ComplaintStatus
  remarks        String?
  updatedById    String
  updatedAt      DateTime        @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  updatedBy User      @relation("StatusUpdatedBy", fields: [updatedById], references: [id])

  @@index([complaintId])
  @@index([updatedById])
  @@map("complaint_status_history")
}

// ─── Complaint Feedback ──────────────────────────────────────────────────────

model ComplaintFeedback {
  id          String @id @default(uuid())
  complaintId String @unique
  citizenId   String
  rating      Int
  comment     String?

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  citizen   User      @relation(fields: [citizenId], references: [id])

  @@index([citizenId])
  @@map("complaint_feedback")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Audit Logs ──────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  module    String
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── System Settings ─────────────────────────────────────────────────────────

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("system_settings")
}

// ─── SLA Rules ───────────────────────────────────────────────────────────────

model SlaRule {
  id              String @id @default(uuid())
  categoryId      String
  hours           Int
  escalationLevel Int    @default(1)

  category ComplaintCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, escalationLevel])
  @@index([categoryId])
  @@map("sla_rules")
}
